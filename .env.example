# Salin ke .env di root repo (gitignored, jangan commit).
# Dipakai drizzle-kit push/generate. Ambil dari Supabase Dashboard >
# Project Settings > Database > Connection string (pakai mode Session pooler,
# port 6543, untuk jaringan dengan batasan; direct port 5432 bila gagal).
# Ganti [YOUR-PASSWORD] dengan database password proyek.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xyzcompany.supabase.co:6543/postgres

# Kunci Gemini: HANYA untuk Edge Function (supabase secrets set GEMINI_API_KEY=...).
# Jangan taruh di Vercel/FE, jangan commit nilainya.
GEMINI_API_KEY=
