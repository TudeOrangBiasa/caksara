{
  // v11b-audio-deploy.test.ts dikecualikan: interop Bun+Deno
  // (Bun global + impor .ts lintas-batas). Diverifikasi via `bun test`
  // file itu + `deno eval` path handler, bukan tsc.
  "exclude": ["src/lib/v11b-audio-deploy.test.ts"],
  "include": ["**/*", "**/.server/**/*", "**/.client/**/*", ".react-router/types/**/*"],
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "types": ["node", "vite/client"],
    "target": "ES2023",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "rootDirs": [".", "./.react-router/types"],
    "paths": {
      "@/*": ["./src/*"],
      "@caksara/ui/*": ["../../packages/ui/src/*"]
    },
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true
  }
}
