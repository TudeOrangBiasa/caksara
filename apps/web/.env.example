# Salin ke apps/web/.env (gitignored, jangan commit).
# Ambil dari Supabase Dashboard > Project Settings > API (format sb_publishable_...).
VITE_SUPABASE_URL=https://xyzcompany.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=isi_dengan_publishable_key

# Catatan: GEMINI_API_KEY tidak ada di sini — ia edge-only
# (supabase secrets set GEMINI_API_KEY=...), bukan env FE.
